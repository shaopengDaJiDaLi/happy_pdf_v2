# Backend
HAPPY_PDF_DATA_DIR=backend/data
PDF_RENDER_SCALE=3
OCR_ENGINE=auto
OCR_LANG=chi_sim+eng

# Text API for instruction expansion
TEXT_OPENAI_API_KEY=
TEXT_OPENAI_BASE_URL=https://api.openai.com/v1
TEXT_OPENAI_MODEL=gpt-5.5
TEXT_HTTP_PROXY=
TEXT_HTTPS_PROXY=
TEXT_ALL_PROXY=
TEXT_OPENAI_DISABLE=0
TEXT_FALLBACK_ON_ERROR=0
TEXT_TIMEOUT_SECONDS=120
TEXT_MAX_RETRIES=1

# Image API for local region editing
IMAGE_OPENAI_API_KEY=
IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_OPENAI_MODEL=gpt-image-2
IMAGE_HTTP_PROXY=
IMAGE_HTTPS_PROXY=
IMAGE_ALL_PROXY=
IMAGE_OPENAI_DISABLE=0
IMAGE_FALLBACK_ON_ERROR=0
IMAGE_TIMEOUT_SECONDS=120
IMAGE_MAX_RETRIES=0

# Local fallback switch for both TEXT and IMAGE services.
OPENAI_DISABLE=0

# Frontend
VITE_API_BASE_URL=
